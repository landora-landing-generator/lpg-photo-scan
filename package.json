{
  "name": "lpg-photo-scan",
  "productName": "LPG Photo Scan",
  "version": "0.1.3",
  "description": "Проверяет список сайтов и показывает, на каких есть фотографии людей",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "scan": "electron src/main/cli.js",
    "test": "vitest run",
    "dist:mac": "electron-builder --mac --arm64 && electron-builder --mac --x64",
    "dist:win": "electron-builder --win",
    "dist:mac-arm64": "electron-builder --mac --arm64",
    "dist:mac-x64": "electron-builder --mac --x64"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.0.12",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron@45.1.0": true,
    "sharp@0.34.5": true,
    "electron-winstaller@5.4.0": true
  },
  "updateRepo": "landora-landing-generator/lpg-photo-scan",
  "downloadPage": "https://landora-landing-generator.github.io/lpg-photo-scan/",
  "build": {
    "appId": "ru.landora.photoscan",
    "artifactName": "lpg-photo-scan-${os}-${arch}.${ext}",
    "files": [
      "src/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "identity": null,
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "LPG Photo Scan",
      "window": {
        "width": 600,
        "height": 420
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "shortcutName": "LPG Photo Scan"
    },
    "publish": null,
    "afterPack": "build/adhoc-sign.cjs",
    "copyright": "© 2026 Андрей Цибин"
  },
  "author": {
    "name": "Андрей Цибин"
  }
}
